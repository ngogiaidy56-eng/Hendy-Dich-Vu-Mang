# HENDY DỊCH VỤ MẠNG — Bot Telegram + Mini App + App Store
APP_ENV=production
PORT=10000
APP_URL=https://hendy-dich-vu-mang.onrender.com
WEBAPP_URL=
ALLOWED_ORIGINS=https://hendy-dich-vu-mang.onrender.com

# MySQL — chỉ phục vụ App Store tại /app_store/
DB_HOST=
DB_PORT=3306
DB_NAME=app_store
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

# PostgreSQL — chỉ phục vụ Telegram Bot, ví, đơn hàng và Mini App
TELEGRAM_RUNTIME_ENABLED=false
DATABASE_URL=
DATABASE_SSL=true
DB_STARTUP_WAIT_SECONDS=120
RUN_MIGRATIONS_ON_START=true

# Bot production và bot thử nghiệm
BOT1_TOKEN=
BOT2_TOKEN=
BOT_HOME_PHOTO=https://i.postimg.cc/rcD583NW/anh-quan-cao.png?dl=1
BOT1_PUBLIC_URL=
BOT2_PUBLIC_URL=
ADMIN_ID=
ADMIN_IDS=

# Chỉ bật webhook sau khi PostgreSQL, BOT1_TOKEN và Admin ID đã được cấu hình
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_SECOND_WEBHOOK_SECRET=
WEBHOOK_AUTO_REGISTER=false
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600
LEGACY_SESSION_SECRET=
WEBSITE_SESSION_TTL_SECONDS=43200

# Liên kết, dịch vụ và tác vụ nền
GROUP_URL=
CHANNEL_URL=
SUPPORT_URL=
VIETQR_BANK_ID=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
HOMEPROXY_ENCRYPTION_KEY=
MEDIA_ALLOWED_HOSTS=youtube.com,youtu.be,tiktok.com,facebook.com,fb.watch
VIDEO_PROCESSOR_URL=
VIDEO_PROCESSOR_SECRET=
VIDEO_WORKER_POLL_SECONDS=5
VIDEO_PROCESSING_STALE_MINUTES=90
BANK_WEBHOOK_ENABLED=false
BANK_WEBHOOK_SECRET=

# WebSocket mặc định tắt
WEBSOCKET_ENABLED=false
WEBSOCKET_URL=wss://hendy-dich-vu-mang.onrender.com/ws
WEBSOCKET_ALLOWED_ORIGINS=https://hendy-dich-vu-mang.onrender.com
WEBSOCKET_MAX_CONNECTIONS=250
WEBSOCKET_BIND=127.0.0.1
WEBSOCKET_PORT=10001
