{
  "version": 1,
  "description": "Manifest môi trường runtime cho Hendy Bot Cybertech. Liên kết Telegram công khai được khai báo thủ công qua BOT1_PUBLIC_URL/BOT2_PUBLIC_URL; ứng dụng không dùng getMe() để tự dò username.",
  "variables": {
    "APP_ENV": {
      "classification": "variable",
      "required": true,
      "source": "github_variable",
      "default": "production",
      "sync_to_render": true
    },
    "PORT": {
      "classification": "variable",
      "required": true,
      "source": "github_variable",
      "default": "10000",
      "sync_to_render": true
    },
    "APP_URL": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "default": "https://hendy-bot-cybertech-1.onrender.com",
      "sync_to_render": true,
      "description": "Production HTTPS URL for the active HENDY Render Web Service."
    },
    "WEBAPP_URL": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "sync_to_render": true,
      "description": "Tùy chọn: URL công khai bổ sung cho origin/WebSocket. Không cần nhập khi có thể dùng RENDER_EXTERNAL_URL."
    },
    "ALLOWED_ORIGINS": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "default": "https://hendy-bot-cybertech-1.onrender.com",
      "sync_to_render": true
    },
    "BOT1_TOKEN": {
      "classification": "secret",
      "required": true,
      "source": "github_secret",
      "sync_to_render": true
    },
    "BOT2_TOKEN": {
      "classification": "secret",
      "required": false,
      "source": "github_secret",
      "sync_to_render": true,
      "delete_on_empty": true
    },
    "BOT_HOME_PHOTO": {
      "classification": "variable",
      "required": false,
      "source": "render_environment",
      "default": "https://i.postimg.cc/rcD583NW/anh-quan-cao.png?dl=1",
      "sync_to_render": false,
      "description": "HENDY Telegram home banner image URL. A missing or unavailable image falls back to a text welcome message."
    },
    "HOMEPROXY_ENCRYPTION_KEY": {
      "classification": "secret",
      "required": false,
      "source": "render_environment",
      "sync_to_render": false,
      "description": "AES-256-GCM secret for encrypting each member's HomeProxy Key Xoay. Generate at least 32 random characters; never use a provider API key."
    },
    "BOT1_PUBLIC_URL": {
      "classification": "variable",
      "required": false,
      "source": "render_environment",
      "sync_to_render": false,
      "description": "Liên kết Telegram công khai của bot chính, ví dụ https://t.me/your_bot. Khai báo thủ công; không gọi getMe()."
    },
    "BOT2_PUBLIC_URL": {
      "classification": "variable",
      "required": false,
      "source": "render_environment",
      "sync_to_render": false,
      "description": "Liên kết Telegram công khai của bot thử nghiệm, ví dụ https://t.me/your_test_bot. Khai báo thủ công; không gọi getMe()."
    },
    "ADMIN_ID": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "sync_to_render": true,
      "required_when": "ADMIN_ID or ADMIN_IDS must contain at least one Telegram user ID"
    },
    "DATABASE_URL": {
      "classification": "secret",
      "required": true,
      "source": "render_postgres",
      "managed_by": "Render PostgreSQL / Blueprint",
      "sync_to_render": false
    },
    "DATABASE_SSL": {
      "classification": "variable",
      "required": true,
      "source": "github_variable",
      "default": "true",
      "sync_to_render": true
    },
    "DB_STARTUP_WAIT_SECONDS": {
      "classification": "variable",
      "required": true,
      "source": "github_variable",
      "default": "120",
      "sync_to_render": true
    },
    "RUN_MIGRATIONS_ON_START": {
      "classification": "variable",
      "required": true,
      "source": "github_variable",
      "default": "true",
      "sync_to_render": true
    },
    "TELEGRAM_WEBHOOK_SECRET": {
      "classification": "secret",
      "required": false,
      "source": "github_secret",
      "generated_if_missing": true,
      "sync_to_render": true,
      "required_when": "WEBHOOK_AUTO_REGISTER=true",
      "description": "Optional primary-bot override. When absent, the application creates and persists a random 256-bit secret in PostgreSQL; it rotates automatically when BOT1_TOKEN changes."
    },
    "TELEGRAM_SECOND_WEBHOOK_SECRET": {
      "classification": "secret",
      "required": false,
      "source": "github_secret",
      "generated_if_missing": true,
      "sync_to_render": true,
      "required_when": "BOT2_TOKEN is set and WEBHOOK_AUTO_REGISTER=true",
      "delete_on_empty": true,
      "description": "Optional secondary-bot override. When absent, the application creates and persists a different random 256-bit secret in PostgreSQL; it rotates automatically when BOT2_TOKEN changes."
    },
    "BANK_WEBHOOK_SECRET": {
      "classification": "secret",
      "required": false,
      "source": "provider_secret",
      "sync_to_render": false,
      "managed_by": "Chỉ cấu hình sau khi adapter chữ ký ngân hàng theo nhà cung cấp đã được triển khai và kiểm thử."
    },
    "WEBHOOK_AUTO_REGISTER": {
      "classification": "variable",
      "required": true,
      "source": "github_variable",
      "default": "true",
      "sync_to_render": true
    },
    "VIETQR_BANK_ID": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "sync_to_render": true
    },
    "VIETQR_ACCOUNT_NO": {
      "classification": "secret",
      "required": false,
      "source": "github_secret",
      "sync_to_render": true
    },
    "VIETQR_ACCOUNT_NAME": {
      "classification": "secret",
      "required": false,
      "source": "github_secret",
      "sync_to_render": true
    },
    "GROUP_URL": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "sync_to_render": true
    },
    "CHANNEL_URL": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "sync_to_render": true
    },
    "TELEGRAM_INIT_DATA_MAX_AGE_SECONDS": {
      "classification": "variable",
      "required": true,
      "source": "github_variable",
      "default": "3600",
      "sync_to_render": true
    },
    "LEGACY_SESSION_SECRET": {
      "classification": "secret",
      "required": false,
      "source": "github_secret",
      "generated_if_missing": true,
      "sync_to_render": true
    },
    "WEBSOCKET_URL": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "default": "wss://hendy-bot-cybertech-1.onrender.com/ws",
      "sync_to_render": true
    },
    "WEBSOCKET_BIND": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "default": "127.0.0.1",
      "sync_to_render": true
    },
    "WEBSOCKET_PORT": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "default": "10001",
      "sync_to_render": true
    },
    "RENDER_EXTERNAL_URL": {
      "classification": "variable",
      "required": false,
      "source": "render_managed",
      "managed_by": "Render",
      "sync_to_render": false
    },
    "GH_TOKEN": {
      "classification": "secret",
      "required": false,
      "source": "github_environment_secret",
      "scope": "ci",
      "sync_to_render": false
    },
    "RENDER_API_KEY": {
      "classification": "secret",
      "required": false,
      "source": "github_environment_secret",
      "scope": "ci",
      "sync_to_render": false
    },
    "RENDER_SERVICE_ID": {
      "classification": "variable",
      "required": false,
      "source": "github_environment_variable",
      "scope": "ci",
      "sync_to_render": false
    },
    "TARGET_ENVIRONMENT": {
      "classification": "variable",
      "required": false,
      "source": "workflow_dispatch_input",
      "scope": "ci",
      "sync_to_render": false
    },
    "GITHUB_REPOSITORY": {
      "classification": "variable",
      "required": false,
      "source": "github_context",
      "scope": "ci",
      "sync_to_render": false
    },
    "GITHUB_SHA": {
      "classification": "variable",
      "required": false,
      "source": "github_context",
      "scope": "ci",
      "sync_to_render": false
    },
    "BANK_WEBHOOK_ENABLED": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "default": "false",
      "sync_to_render": true,
      "managed_by": "Phải giữ false cho đến khi adapter chữ ký ngân hàng được triển khai."
    },
    "GITHUB_ENV": {
      "classification": "variable",
      "required": false,
      "source": "github_context",
      "scope": "ci",
      "sync_to_render": false
    },
    "ADMIN_IDS": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "sync_to_render": true,
      "description": "Danh sách Telegram admin bổ sung, phân tách bằng dấu phẩy."
    },
    "MEDIA_ALLOWED_HOSTS": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "default": "youtube.com,youtu.be,tiktok.com,facebook.com,fb.watch",
      "sync_to_render": true
    },
    "VIDEO_PROCESSOR_URL": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "sync_to_render": true,
      "required_when": "Khi muốn worker dispatch video jobs"
    },
    "VIDEO_PROCESSOR_SECRET": {
      "classification": "secret",
      "required": false,
      "source": "github_secret",
      "sync_to_render": true,
      "required_when": "Khi muốn worker dispatch và xác minh callback"
    },
    "VIDEO_WORKER_POLL_SECONDS": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "default": "5",
      "sync_to_render": true
    },
    "VIDEO_PROCESSING_STALE_MINUTES": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "default": "90",
      "sync_to_render": true,
      "description": "Phút trước khi một job processing bị coi là worker bị restart."
    },
    "WEBSOCKET_ALLOWED_ORIGINS": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "default": "https://hendy-bot-cybertech-1.onrender.com",
      "sync_to_render": true
    },
    "WEBSOCKET_MAX_CONNECTIONS": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "default": "250",
      "sync_to_render": true
    },
    "WEBSOCKET_ENABLED": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "default": "false",
      "sync_to_render": true,
      "description": "Bật tiến trình Ratchet nội bộ cùng Apache trong cùng Render service."
    },
    "WEBSITE_SESSION_TTL_SECONDS": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "default": "43200",
      "sync_to_render": true
    },
    "SUPPORT_URL": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "sync_to_render": true,
      "description": "Liên kết hỗ trợ Telegram công khai; backend chỉ xuất URL HTTPS thuộc t.me/telegram.me."
    },
    "GROUP_CHAT_URL": {
      "classification": "variable",
      "required": false,
      "source": "legacy_render_environment",
      "sync_to_render": false,
      "description": "Tên tương thích ngược của GROUP_URL; tùy chọn, không đồng bộ tự động."
    },
    "NEWS_CHANNEL_URL": {
      "classification": "variable",
      "required": false,
      "source": "legacy_render_environment",
      "sync_to_render": false,
      "description": "Tên tương thích ngược của CHANNEL_URL; tùy chọn, không đồng bộ tự động."
    }
  }
}
